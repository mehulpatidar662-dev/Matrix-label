# Database & Cache
DATABASE_URL=postgresql+psycopg://annoting:annoting_dev_password@localhost:5432/annoting
REDIS_URL=redis://localhost:6379/0

# Storage (S3 / MinIO)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=annoting-datasets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword

# Auth & Security
JWT_SECRET=change_me_to_a_secure_random_string_at_least_32_chars_long
COOKIE_SECURE=false

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# URLs & CORS
WEB_ORIGIN=http://localhost:3000
API_URL=http://localhost:8000

# Business Rules & Toggles
GST_RATE=0.18
DEMO_MODE=true
PAYMENTS_ENABLED=false
NEXT_PUBLIC_USE_MOCKS=false
